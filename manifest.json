{
  "manifest_version": 3,
  "name": "Unload Pinned Tabs (Arc-style)",
  "version": "1.0.0",
  "description": "When closing a pinned tab (Ctrl+W), it gets unloaded instead of being closed/unpinned, like on Arc.",
  "permissions": ["tabs", "commands", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Unload this pinned tab"
  },
  "commands": {
    "close-or-unload-tab": {
      "suggested_key": {
        "default": "Ctrl+W",
        "mac": "Command+W"
      },
      "description": "Close the tab, or unload it if it's pinned"
    }
  }
}
